# 网关认证 token（必填）
# Claude Code 用此 token 调用网关
LITELLM_MASTER_KEY=sk-local-gateway-xxx

# 智谱 BigModel
GLM_API_KEY=

# 小米 MiMo
MIMO_API_KEY=

# 美团 LongCat
LONGCAT_API_KEY=

# EasyClaw（OpenAI 格式，真实 Claude）
EASYCLAW_API_KEY=

# OpenRouter（免费模型，启动时自动拉取最优免费模型列表，/model free 使用）
# 免费 key：https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepV Server（内部 AI 模型聚合服务）
# 启用后支持 deepseek-flash, glm-5, claude-sonnet-4-6 等模型
DEEPV_ENABLED=false
DEEPV_WORK_DIR=

# APIFree（SkyClaw-v1 agent 模型）
APIFREE_API_KEY=

# HTTP 代理（用于访问 ChatGPT Codex API，国内网络需要）
# 设置后自动启用 ChatGPT OAuth provider，使用 ~/.codex/auth.json 中的 token
HTTP_PROXY=http://127.0.0.1:7890

# 网关监听端口（默认 4000）
PORT=4001

# 日志级别
LOG_LEVEL=info
