# 网关认证 token（必填）
# Claude Code 用此 token 调用网关
LITELLM_MASTER_KEY=sk-local-gateway-xxx

# 智谱 BigModel
GLM_API_KEY=

# 小米 MiMo
MIMO_API_KEY=

# 美团 LongCat
LONGCAT_API_KEY=

# HTTP 代理（用于访问 ChatGPT Codex API，国内网络需要）
# 设置后自动启用 ChatGPT OAuth provider，使用 ~/.codex/auth.json 中的 token
HTTP_PROXY=http://127.0.0.1:7890

# GitHub Copilot（短期 token，约 30 分钟有效）
# COPILOT_TOKEN=
# GitHub OAuth token（用于自动刷新 Copilot token）
# COPILOT_GITHUB_TOKEN=

# 网关监听端口（默认 4001）
PORT=4001

# 日志级别
LOG_LEVEL=info
