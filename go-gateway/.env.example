# 网关认证 token（必填）
# Claude Code 用此 token 调用网关
LITELLM_MASTER_KEY=sk-local-gateway-xxx

# 可选：独立的 Dashboard 管理 token；不设置时使用上面的 master key
# ADMIN_TOKEN=sk-local-admin-xxx

# 智谱 BigModel
GLM_API_KEY=

# 阿里 MaaS（qwen3.8-max-preview, ali-opus）
ALI_API_KEY=
# 兼容旧的本地配置名（ALI_API_KEY 优先）
# ALIYUN_MAAS_API_KEY=


# HTTP 代理（访问 ChatGPT Codex API 时可选，国内网络通常需要）
# 不设置时直接连接；设置后优先使用此代理。
# HTTP_PROXY=http://127.0.0.1:7890

# 可选：指定 ChatGPT/Pi OAuth 凭证文件。
# 未设置时依次读取 ~/.codex/auth.json、~/.pi/agent/auth.json。
# CHATGPT_AUTH_FILE=

# GitHub Copilot（短期 token，约 30 分钟有效）
# COPILOT_TOKEN=
# GitHub OAuth token（用于自动刷新 Copilot token）
# COPILOT_GITHUB_TOKEN=

# DeepV Server（EasyCode/DeepVCode 聚合服务，读本地 JWT 登录态，无需 API Key）
# 启用后提供 deepseek-v4-flash 与 deepseek-v4-flash-vision-exp 两个模型。
# 认证 token 自动读取 ~/.easycode-user/jwt-token.json，其次 ~/.deepv/jwt-token.json。
DEEPV_ENABLED=false
# 可选：DeepV 工作目录（用于附加 Git 仓库信息头，默认取网关启动目录）
# DEEPV_WORK_DIR=

# 网关监听端口（默认 4001）
PORT=4001

# 日志级别
LOG_LEVEL=info

# Provider 熔断：连续失败次数、恢复探测间隔、半开成功次数
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30
CIRCUIT_SUCCESS_THRESHOLD=1

# ── 对话归档 ──────────────────────────────────────────────────────────────
# 归档默认关闭。启用后会将完整的 request/response 正文（脱敏后）写入
# conversation_archives 表，与 request_logs 物理隔离，可用于知识库增量导出。
# ARCHIVE_ENABLED=false
# 单条 body 的截断阈值（KB），超出部分会被截断并标记 ...[truncated]
# ARCHIVE_MAX_BODY_KB=16384
# 归档保留天数，超期记录由后台清理任务自动删除
# ARCHIVE_RETENTION_DAYS=90
